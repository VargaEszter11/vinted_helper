# Used by docker-compose.yml. Copy to .env and change the secrets.
DB_USER=vinted
DB_PASSWORD=change-me
DB_NAME=vinted

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-too

# The admin account (the only one that can open the Admin tab). It is created on start if it
# does not exist yet, and cannot be registered through the app. Use a long password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-as-well

# Buy check (identifying an item from photos) calls DeepSeek from the backend only.
# Get a key at https://platform.deepseek.com. Without it, Buy check says it is not set up.
DEEPSEEK_API_KEY=

# Set to false to stop new accounts being created.
ALLOW_REGISTRATION=true

# Port the web app is published on.
WEB_PORT=8080
