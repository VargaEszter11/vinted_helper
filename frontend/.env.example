# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard > Project Settings > API Keys (the URL is under Project Settings > Data API).
# These values are bundled into the app. That is fine: you need to sign in to see any data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
